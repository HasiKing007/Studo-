# Kopiere nach .env und passe an.
# Öffentliche Basis-URL (für den Kalender-Abo-Link), z. B. via Tailscale Funnel / Caddy
STUDO_BASE_URL=https://studo.example.ts.net
# Datenbank-Pfad
STUDO_DB=./data/studo.db
# Master-Key für die Verschlüsselung gespeicherter Geheimnisse (KUSSS-Passwort, iCal-Link).
# Erzeugen mit:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NIE in die DB oder ins Git legen. Alternativ im macOS-Schlüsselbund / systemd-credentials.
STUDO_MASTER_KEY=
# Sync-Intervall in Minuten
STUDO_SYNC_MINUTES=30
# 1 = Demo-Modus: Login ohne JKU-Prüfung, Beispieltermine (zum Ausprobieren)
STUDO_DEMO=0
