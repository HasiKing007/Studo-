{
  // Studo+ auf Cloudflare Workers (Gratis-Plan): API + Kalender-Feed + PWA-Dateien.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studo-plus",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,

  // Das PWA-Frontend wird als statische Dateien mit ausgeliefert.
  "assets": {
    "directory": "../frontend",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // Durable Objects mit eingebauter SQLite-Datenbank (im Gratis-Plan enthalten):
  // STORE = eines pro Konto (Termine, Schalter, Sessions), REGISTRY = Nutzungszahlen + Rate-Limit.
  "durable_objects": {
    "bindings": [
      { "name": "STORE", "class_name": "StudoStore" },
      { "name": "REGISTRY", "class_name": "Registry" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["StudoStore"] },
    { "tag": "v2", "new_sqlite_classes": ["Registry"] }
  ],

  // Admin-Zugang: eigenes Konto "admin", Passwort als Secret ADMIN_PASSWORD
  // (wird beim Deployment aus dem GitHub-Secret STUDO_ADMIN_PASSWORD gesetzt).

  "observability": { "enabled": true }
}
