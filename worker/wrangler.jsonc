{
  // Studo+ auf Cloudflare Workers (Gratis-Plan): API + Kalender-Feed + PWA-Dateien.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studo-plus",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,

  // Das PWA-Frontend wird als statische Dateien mit ausgeliefert.
  "assets": {
    "directory": "../frontend",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // Ein Durable Object mit eingebauter SQLite-Datenbank speichert alles
  // (Termine, Schalter, Einstellungen, Sessions). Im Gratis-Plan enthalten.
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "StudoStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StudoStore"] }],

  "observability": { "enabled": true }
}
